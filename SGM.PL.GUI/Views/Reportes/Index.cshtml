@model SGM.Application.BL.BE.ReporteResumen
@{
    ViewData["Title"] = "Reportes";
}

<div class="container-fluid py-3">

    <!-- Encabezado -->
    <div class="mb-4 text-center">
        <h2 class="fw-bold mb-1">Reportes</h2>
        <p class="text-muted mb-0">
            Resumen general del sistema
        </p>
    </div>

    <!-- PRIMER GRUPO: Monto, Ventas y Clientes -->
    <div class="row g-4 justify-content-center">

        <!-- Monto vendido -->
        <div class="col-lg-4 col-md-6">
            <div class="card border-0 shadow-sm h-100" style="background: #f8f9fa;">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted mb-2">Monto total vendido</p>
                            <h3 class="fw-bold mb-1 text-success">
                                S/ @Model.MontoTotalVendido.ToString("N2")
                            </h3>
                            <small class="text-muted">
                                <i class="bi bi-clock me-1"></i>
                                Total acumulado
                            </small>
                        </div>
                        <div class="bg-success bg-opacity-10 text-success rounded-3 p-3">
                            <i class="bi bi-currency-dollar fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Ventas -->
        <div class="col-lg-4 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted mb-2">Ventas registradas</p>
                            <h3 class="fw-bold mb-0">@Model.TotalVentas</h3>
                            <small class="text-muted">Transacciones</small>
                        </div>
                        <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-3">
                            <i class="bi bi-cart-check fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Clientes -->
        <div class="col-lg-4 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted mb-2">Clientes</p>
                            <h3 class="fw-bold mb-0">@Model.TotalClientes</h3>
                            <small class="text-muted">Registrados</small>
                        </div>
                        <div class="bg-info bg-opacity-10 text-info rounded-3 p-3">
                            <i class="bi bi-people fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- SEGUNDO GRUPO: Productos, Categorías y Empleados -->
    <div class="row g-4 mt-2 justify-content-center">

        <!-- Productos -->
        <div class="col-lg-3 col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-2">Productos</p>
                            <h4 class="fw-bold mb-0">@Model.TotalProductos</h4>
                        </div>
                        <div class="bg-warning bg-opacity-10 text-warning rounded-3 p-2 px-3">
                            <i class="bi bi-box-seam fs-5"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Categorías -->
        <div class="col-lg-3 col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-2">Categorías</p>
                            <h4 class="fw-bold mb-0">@Model.TotalCategorias</h4>
                        </div>
                        <div class="bg-secondary bg-opacity-10 text-secondary rounded-3 p-2 px-3">
                            <i class="bi bi-tags fs-5"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Empleados -->
        <div class="col-lg-3 col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-2">Empleados</p>
                            <h4 class="fw-bold mb-0">@Model.TotalEmpleados</h4>
                        </div>
                        <div class="bg-dark bg-opacity-10 text-dark rounded-3 p-2 px-3">
                            <i class="bi bi-person-badge fs-5"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Pie de página - Solo fecha de actualización -->
    <div class="mt-4 pt-3 border-top text-center">
        <small class="text-muted">
            <i class="bi bi-calendar3 me-1"></i>
            Última actualización: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
        </small>
    </div>

</div>