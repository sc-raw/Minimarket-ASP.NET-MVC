<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - SGM</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <style>
        /* ================================
           FOOTER
           ================================ */

        .main-footer {
            background: #111827;
            color: white;
        }

        .main-footer a {
            transition: all 0.2s ease;
        }

        .main-footer a:hover {
            color: white !important;
            padding-left: 5px;
        }

        .footer-brand-icon {
            width: 42px;
            height: 42px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 10px;
            background: rgba(255, 255, 255, 0.1);
            margin-right: 10px;
        }

        .footer-social {
            width: 38px;
            height: 38px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.08);
            color: #9ca3af;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .footer-social:hover {
            background: rgba(255, 255, 255, 0.18);
            color: white !important;
            padding-left: 0 !important;
        }

        .footer-title {
            position: relative;
            padding-bottom: 10px;
            margin-bottom: 18px;
        }

        .footer-title::after {
            content: "";
            position: absolute;
            left: 0;
            bottom: 0;
            width: 35px;
            height: 2px;
            background: #0d6efd;
        }
    </style>
</head>

<!-- Se quitó flex-column para que los elementos se posicionen uno al lado del otro -->
<body class="d-flex min-vh-100">

    @{
        var rol = Context.Session.GetString("Rol");
        var nombres = Context.Session.GetString("Nombres") ?? Context.Session.GetString("Username");
        var estaLogueado = !string.IsNullOrEmpty(Context.Session.GetString("Username"));
    }

    @if (estaLogueado)
    {
        <!-- ================================
             SIDEBAR (Columna Izquierda)
             ================================ -->
        <div class="bg-primary text-white p-3 d-flex flex-column flex-shrink-0"
             style="width: 280px; position: sticky; top: 0; height: 100vh; overflow-y: auto;">

            <!-- Brand -->
            <div class="text-center border-bottom border-light border-opacity-25 pb-3 mb-3">
                <h3 class="fw-bold mb-0">
                    <i class="bi bi-shop me-1"></i>
                    SGM
                </h3>
                <small class="opacity-75">
                    Sistema de Gestion para Minimarket
                </small>
                <br />
                <span class="badge bg-light text-primary mt-2">
                    @DateTime.Now.ToString("dd/MM/yyyy")
                </span>
            </div>

            <!-- MENÚ -->
            <ul class="nav nav-pills flex-column flex-grow-1">
                <li class="nav-item mb-1">
                    <a class="nav-link text-white @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active bg-white bg-opacity-25" : "")" href="/Home">
                        <i class="bi bi-house me-2"></i> Inicio
                    </a>
                </li>
                <li class="nav-item mb-1">
                    <a class="nav-link text-white @(ViewContext.RouteData.Values["controller"]?.ToString() == "Clientes" ? "active bg-white bg-opacity-25" : "")" href="/Clientes">
                        <i class="bi bi-people me-2"></i> Clientes
                    </a>
                </li>
                <li class="nav-item mb-1">
                    <a class="nav-link text-white @(ViewContext.RouteData.Values["controller"]?.ToString() == "Ventas" && ViewContext.RouteData.Values["action"]?.ToString() != "Create" ? "active bg-white bg-opacity-25" : "")" href="/Ventas">
                        <i class="bi bi-receipt me-2"></i> Ventas
                    </a>
                </li>
                <li class="nav-item mb-1">
                    <a class="nav-link text-white @(ViewContext.RouteData.Values["action"]?.ToString() == "Create" ? "active bg-white bg-opacity-25" : "")" href="/Ventas/Create">
                        <i class="bi bi-cart-plus me-2"></i> Nueva Venta
                    </a>
                </li>

                @if (rol == "Administrador")
                {
                    <li class="nav-item mb-1">
                        <a class="nav-link text-white @(ViewContext.RouteData.Values["controller"]?.ToString() == "Categorias" ? "active bg-white bg-opacity-25" : "")" href="/Categorias">
                            <i class="bi bi-tags me-2"></i> Categorías
                        </a>
                    </li>
                    <li class="nav-item mb-1">
                        <a class="nav-link text-white @(ViewContext.RouteData.Values["controller"]?.ToString() == "Productos" ? "active bg-white bg-opacity-25" : "")" href="/Productos">
                            <i class="bi bi-box-seam me-2"></i> Productos
                        </a>
                    </li>
                    <li class="nav-item mb-1">
                        <a class="nav-link text-white @(ViewContext.RouteData.Values["controller"]?.ToString() == "Usuarios" ? "active bg-white bg-opacity-25" : "")" href="/Usuarios">
                            <i class="bi bi-person-badge me-2"></i> Empleados
                        </a>
                    </li>
                    <li class="nav-item mb-1">
                        <a class="nav-link text-white @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reportes" ? "active bg-white bg-opacity-25" : "")" href="/Reportes">
                            <i class="bi bi-bar-chart me-2"></i> Reportes
                        </a>
                    </li>
                }
            </ul>

            <!-- USUARIO -->
            <div class="border-top border-light border-opacity-25 pt-3 mt-auto"
                 style="background: linear-gradient(180deg, transparent, #0d6efd 30%);">
                <div class="d-flex align-items-center justify-content-between" style="border-radius: 10px; padding: 10px 14px; background: rgba(255,255,255,0.08);">
                    <div class="d-flex align-items-center gap-2">
                        <div class="bg-white bg-opacity-25 rounded-circle p-1 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                            <i class="bi bi-person-fill text-white fs-5"></i>
                        </div>
                        <div>
                            <div class="fw-semibold" style="font-size: 0.95rem;">@nombres</div>
                            <div class="small opacity-75" style="font-size: 0.75rem;">@rol</div>
                        </div>
                    </div>
                    <div class="dropdown">
                        <button class="btn p-1" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="border: none; color: white; opacity: 0.7; transition: opacity 0.2s;" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.7'">
                            <i class="bi bi-box-arrow-right fs-5"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end" style="border-radius: 10px; box-shadow: 0 8px 25px rgba(0,0,0,0.15); border: none; min-width: 180px; padding: 6px 0;">
                            <li>
                                <a class="dropdown-item d-flex align-items-center gap-2 py-2 px-3" href="/Account/Perfil" style="border-radius: 6px; margin: 0 4px;">
                                    <i class="bi bi-person" style="width: 18px;"></i> Mi Perfil
                                </a>
                            </li>
                            <li>
                                <hr class="dropdown-divider" style="margin: 4px 12px;" />
                            </li>
                            <li>
                                <a class="dropdown-item d-flex align-items-center gap-2 py-2 px-3 text-danger" href="/Account/Logout" style="border-radius: 6px; margin: 0 4px;">
                                    <i class="bi bi-box-arrow-right" style="width: 18px;"></i> Cerrar sesión
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    }


    <!-- ================================
         CONTENEDOR DERECHO (Main + Footer)
         Este div ocupa el espacio sobrante
         ================================ -->
    <div class="d-flex flex-column flex-grow-1" style="min-width: 0; min-height: 100vh;">

        @if (estaLogueado)
        {
            <!-- CONTENIDO DE PÁGINAS LOGUEADAS -->
            <main class="flex-grow-1 p-4">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle me-2"></i>
                        @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @RenderBody()
            </main>
        }
        else
        {
            <!-- CONTENIDO DE LOGIN O NO LOGUEADOS -->
            <main class="flex-grow-1">
                <div class="container mt-4">
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-triangle me-2"></i> @TempData["Error"]
                        </div>
                    }

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">
                            <i class="bi bi-check-circle me-2"></i> @TempData["Success"]
                        </div>
                    }

                    @RenderBody()
                </div>
            </main>
        }

<footer class="main-footer mt-auto border-top border-secondary">
            <div class="container py-3">
                <div class="row align-items-center">
                    <div class="col-md-6 text-center text-md-start">
                        <small class="text-secondary">
                            © @DateTime.Now.Year SGM Minimarket. Todos los derechos reservados.
                        </small>
                    </div>
                    <div class="col-md-6 text-center text-md-end mt-2 mt-md-0">
                        <small class="text-secondary">
                            Sistema de Gestión para Minimarket 
                        </small>
                    </div>
                </div>
            </div>
        </footer>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)

</body>
</html>