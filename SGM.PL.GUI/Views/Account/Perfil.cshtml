@model SGM.Domain.Entities.Usuario
@{
    ViewData["Title"] = "Mi Perfil";
}

<h2>Mi Perfil</h2>
<hr />

<div class="card" style="max-width: 500px;">
    <div class="card-body">
        <div class="d-flex align-items-center gap-3 mb-4">
            <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center"
                 style="width: 64px; height: 64px;">
                <i class="bi bi-person-fill text-primary" style="font-size: 2rem;"></i>
            </div>
            <div>
                <h4 class="mb-0">@Model.Nombres @Model.Apellidos</h4>
                <span class="badge @(Model.Rol == "Administrador" ? "bg-danger" : "bg-info")">@Model.Rol</span>
            </div>
        </div>

        <dl class="row mb-0">
            <dt class="col-sm-4">Usuario</dt>
            <dd class="col-sm-8">@Model.Username</dd>

            <dt class="col-sm-4">Nombres</dt>
            <dd class="col-sm-8">@(Model.Nombres ?? "-")</dd>

            <dt class="col-sm-4">Apellidos</dt>
            <dd class="col-sm-8">@(Model.Apellidos ?? "-")</dd>

            <dt class="col-sm-4">Rol</dt>
            <dd class="col-sm-8">@Model.Rol</dd>

            <dt class="col-sm-4">Estado</dt>
            <dd class="col-sm-8">
                @if (Model.Estado)
                {
                    <span class="badge bg-success">Activo</span>
                }
                else
                {
                    <span class="badge bg-secondary">Inactivo</span>
                }
            </dd>
        </dl>
    </div>
</div>