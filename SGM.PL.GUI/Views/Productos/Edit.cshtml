@model SGM.Domain.Entities.Producto
@{
    ViewData["Title"] = "Editar Producto";
}

<h2>Editar Producto</h2>
<hr />

<form method="post" class="w-50">
    <input type="hidden" name="IdProducto" value="@Model.IdProducto" />
    <div class="mb-3">
        <label class="form-label">Código</label>
        <input type="text" name="Codigo" class="form-control" value="@Model.Codigo" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Nombre</label>
        <input type="text" name="Nombre" class="form-control" value="@Model.Nombre" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Descripción</label>
        <input type="text" name="Descripcion" class="form-control" value="@Model.Descripcion" />
    </div>
    <div class="mb-3">
        <label class="form-label">Precio</label>
        <input type="number" step="0.01" name="Precio" class="form-control" value="@Model.Precio" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Stock</label>
        <input type="number" name="Stock" class="form-control" value="@Model.Stock" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Categoría</label>
        <select name="IdCategoria" class="form-select" asp-items="ViewBag.Categorias" required></select>
    </div>
    <div class="mb-3 form-check">
        <input type="checkbox" name="Estado" value="true" class="form-check-input" @(Model.Estado ? "checked" : "") />
        <label class="form-check-label">Activo</label>
    </div>
    <button type="submit" class="btn btn-primary">Actualizar</button>
    <a href="/Productos" class="btn btn-secondary">Cancelar</a>
</form>