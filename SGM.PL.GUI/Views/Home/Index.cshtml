@{
    ViewData["Title"] = "Inicio";
    var rol = ViewBag.Rol as string;
    var nombres = ViewBag.Nombres as string;
}

<div class="text-center mt-5">
    <h1 class="display-5">Bienvenido, @nombres</h1>
    <p class="lead text-muted">Rol: <strong>@rol</strong></p>
    <hr />

    <div class="row justify-content-center mt-4">
        <div class="col-md-3 mb-3">
            <a href="/Ventas/Create" class="btn btn-success btn-lg w-100">
                <i class="bi bi-cart-plus"></i><br />Nueva Venta
            </a>
        </div>

        @if (rol == "Administrador")
        {
            <div class="col-md-3 mb-3">
                <a href="/Productos" class="btn btn-primary btn-lg w-100">
                    <i class="bi bi-box-seam"></i><br />Productos
                </a>
            </div>
            <div class="col-md-3 mb-3">
                <a href="/Usuarios" class="btn btn-secondary btn-lg w-100">
                    <i class="bi bi-people"></i><br />Usuarios
                </a>
            </div>
        }
    </div>
</div>