@model List<SGM.Domain.Entities.Usuario>
@{
    ViewData["Title"] = "Empleados";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Empleados</h2>
    <a href="/Usuarios/Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Nuevo Empleado
    </a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Username</th>
            <th>Nombres</th>
            <th>Rol</th>
            <th>Estado</th>
            <th style="width:180px">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Username</td>
                <td>@(item.Nombres) @(item.Apellidos)</td>
                <td>
                    <span class="badge @(item.Rol == "Administrador" ? "bg-danger" : "bg-info")">
                        @item.Rol
                    </span>
                </td>
                <td>
                    @if (item.Estado)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactivo</span>
                    }
                </td>
                <td>
                    <a href="/Usuarios/Edit/@item.Id" class="btn btn-sm btn-warning">Editar</a>
                    <a href="/Usuarios/Delete/@item.Id" class="btn btn-sm btn-danger"
                       onclick="return confirm('¿Eliminar este usuario?')">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>