


@{
    ViewData["Title"] = "Nueva Venta";
    var productos = ViewBag.Productos as List<SGM.Domain.Entities.Producto>;
}

<h2>Nueva Venta</h2>
<hr />


<style>
    .venta-card {
        background: #fff;
        border-radius: 14px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.08);
        overflow: hidden;
    }

    .venta-header {
        background: #198754;
        color: #fff;
        padding: 14px 18px;
        font-weight: 600;
        font-size: 1.1rem;
    }

    .venta-body {
        padding: 20px;
    }

    .total-box {
        background: #e8f5e9;
        border-radius: 10px;
        padding: 14px 16px;
        text-align: right;
        font-weight: 700;
        font-size: 1.15rem;
        color: #198754;
    }
</style>

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="venta-card">
            <div class="venta-header">
                <i class="bi bi-cart3 me-2"></i> Nueva Venta
            </div>

            <div class="venta-body">
                <!-- Cliente -->
                <div class="mb-4">
                    <label class="form-label fw-semibold">Cliente</label>
                    <select id="IdCliente" class="form-select" asp-items="ViewBag.Clientes">
                        <option value="">-- Seleccione cliente --</option>
                    </select>
                </div>

                <!-- Productos a vender -->
                <h6 class="fw-semibold mb-3">
                    <i class="bi bi-list-ul me-1"></i> Productos a vender
                </h6>

                <div class="row g-2 align-items-end mb-2">
                    <div class="col-md-5">
                        <label class="form-label">Producto</label>
                        <select id="productoSelect" class="form-select" onchange="mostrarDatosProducto()">
                            <option value="">-- Seleccione producto --</option>
                            @if (productos != null)
                            {
                                foreach (var p in productos)
                                {
                                    <option value="@p.IdProducto"
                                            data-nombre="@p.Nombre"
                                            data-codigo="@p.Codigo"
                                            data-precio="@p.Precio"
                                            data-stock="@p.Stock">
                                        @p.Codigo - @p.Nombre
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Stock</label>
                        <input type="text" id="stockProducto" class="form-control" readonly />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Precio (S/)</label>
                        <input type="text" id="precioProducto" class="form-control" readonly />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Cantidad</label>
                        <input type="number" id="cantidad" class="form-control" value="1" min="1" />
                    </div>

                    <div class="col-md-1">
                        <button type="button" class="btn btn-outline-danger w-100" onclick="limpiarProducto()" title="Limpiar">
                            −
                        </button>
                    </div>
                </div>

                <button type="button" class="btn btn-outline-success btn-sm mb-3" onclick="agregarProducto()">
                    <i class="bi bi-plus-circle"></i> Agregar producto
                </button>

                <!-- Carrito -->
                <div class="table-responsive mb-3">
                    <table class="table table-sm table-hover align-middle" id="tablaCarrito">
                        <thead class="table-light">
                            <tr>
                                <th>Producto</th>
                                <th>Precio</th>
                                <th>Cant.</th>
                                <th>Subtotal</th>
                                <th style="width:60px"></th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>

                <div class="total-box mb-4">
                    Total: S/ <span id="totalVenta">0.00</span>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a href="/Ventas" class="btn btn-secondary">Cancelar</a>
                    <button type="button" class="btn btn-success" onclick="abrirConfirmacion()">
                        <i class="bi bi-cash-coin"></i> Pagar
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal de confirmación (único modal) -->
<div class="modal fade" id="modalConfirmar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">Confirmar venta</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2">¿Estás seguro de registrar esta venta?</p>
                <p class="mb-0 text-muted">
                    Total a cobrar: <strong>S/ <span id="totalConfirmar">0.00</span></strong>
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-success" onclick="registrarVenta()">
                    Aceptar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let carrito = [];

        function mostrarDatosProducto() {
            const select = document.getElementById('productoSelect');
            const option = select.options[select.selectedIndex];

            if (!option.value) {
                document.getElementById('precioProducto').value = '';
                document.getElementById('stockProducto').value = '';
                return;
            }

            document.getElementById('precioProducto').value = parseFloat(option.dataset.precio).toFixed(2);
            document.getElementById('stockProducto').value = option.dataset.stock;
        }

        function limpiarProducto() {
            document.getElementById('productoSelect').selectedIndex = 0;
            document.getElementById('precioProducto').value = '';
            document.getElementById('stockProducto').value = '';
            document.getElementById('cantidad').value = 1;
        }

        function agregarProducto() {
            const select = document.getElementById('productoSelect');
            const option = select.options[select.selectedIndex];

            if (!option.value) {
                alert('Seleccione un producto');
                return;
            }

            const idProducto = parseInt(option.value);
            const nombre = option.dataset.codigo + ' - ' + option.dataset.nombre;
            const precio = parseFloat(option.dataset.precio);
            const stock = parseInt(option.dataset.stock);
            const cantidad = parseInt(document.getElementById('cantidad').value);

            if (isNaN(cantidad) || cantidad <= 0) {
                alert('La cantidad debe ser mayor a 0');
                return;
            }

            if (cantidad > stock) {
                alert('Stock insuficiente. Disponible: ' + stock);
                return;
            }

            const existe = carrito.find(x => x.idProducto === idProducto);
            if (existe) {
                if (existe.cantidad + cantidad > stock) {
                    alert('Stock insuficiente. Disponible: ' + stock);
                    return;
                }
                existe.cantidad += cantidad;
                existe.subtotal = existe.cantidad * existe.precio;
            } else {
                carrito.push({
                    idProducto: idProducto,
                    nombre: nombre,
                    precio: precio,
                    cantidad: cantidad,
                    subtotal: precio * cantidad
                });
            }

            renderCarrito();
            limpiarProducto();
        }

        function eliminarItem(index) {
            carrito.splice(index, 1);
            renderCarrito();
        }

        function renderCarrito() {
            const tbody = document.querySelector('#tablaCarrito tbody');
            tbody.innerHTML = '';
            let total = 0;

            carrito.forEach((item, index) => {
                total += item.subtotal;
                tbody.innerHTML += `
                                <tr>
                                    <td>${item.nombre}</td>
                                    <td>S/ ${item.precio.toFixed(2)}</td>
                                    <td>${item.cantidad}</td>
                                    <td>S/ ${item.subtotal.toFixed(2)}</td>
                                    <td>
                                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="eliminarItem(${index})">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>`;
            });

            document.getElementById('totalVenta').innerText = total.toFixed(2);
        }

        function abrirConfirmacion() {
            const idCliente = document.getElementById('IdCliente').value;

            if (!idCliente) {
                alert('Seleccione un cliente');
                return;
            }

            if (carrito.length === 0) {
                alert('El carrito está vacío');
                return;
            }

            document.getElementById('totalConfirmar').innerText =
                document.getElementById('totalVenta').innerText;

            const modal = new bootstrap.Modal(document.getElementById('modalConfirmar'));
            modal.show();
        }

        function registrarVenta() {
            const idCliente = document.getElementById('IdCliente').value;

            const request = {
                idCliente: parseInt(idCliente),
                detalles: carrito.map(x => ({
                    idProducto: x.idProducto,
                    cantidad: x.cantidad,
                    precio: x.precio
                }))
            };

            fetch('/Ventas/Create', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(request)
            })
                .then(res => res.json())
                .then(data => {
                    const modalEl = document.getElementById('modalConfirmar');
                    const modal = bootstrap.Modal.getInstance(modalEl);
                    if (modal) modal.hide();

                    if (data.success) {
                        // Sin alert: va a Ventas y ahí se muestra el mensaje
                        window.location.href = '/Ventas';
                    } else {
                        alert('Error: ' + data.message); // solo si falla
                    }
                })
                .catch(err => {
                    console.error(err);
                    alert('Error al registrar la venta');
                });
        }
    </script>
}