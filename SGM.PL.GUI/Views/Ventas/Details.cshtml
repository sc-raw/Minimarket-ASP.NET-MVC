@model SGM.Domain.Entities.Venta
@{
    ViewData["Title"] = "Detalle de Venta";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Detalle de Venta #@Model.Id</h2>
    <a href="/Ventas" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Volver
    </a>
</div>

<div class="card mb-4">
    <div class="card-header bg-primary text-white">Información General</div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-3">
                <strong>Fecha:</strong>
                <p>@Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</p>
            </div>
            <div class="col-md-3">
                <strong>Cliente:</strong>
                <p>@(Model.Cliente != null ? $"{Model.Cliente.Nombres} {Model.Cliente.Apellidos}" : $"ID {Model.IdCliente}")</p>
            </div>
            <div class="col-md-3">
                <strong>Cajero:</strong>
                <p>@(Model.Usuario != null ? $"{Model.Usuario.Nombres} {Model.Usuario.Apellidos}" : $"ID {Model.IdUsuario}")</p>
            </div>
            <div class="col-md-3">
                <strong>Estado:</strong>
                <p>
                    @if (Model.Estado == "Completada")
                    {
                        <span class="badge bg-success">@Model.Estado</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">@Model.Estado</span>
                    }
                </p>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header bg-success text-white">Productos Vendidos</div>
    <div class="card-body">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Código</th>
                    <th>Producto</th>
                    <th>Precio</th>
                    <th>Cantidad</th>
                    <th>Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var detalle in Model.Detalles)
                {
                    <tr>
                        <td>@(detalle.Producto?.Codigo ?? "-")</td>
                        <td>@(detalle.Producto?.Nombre ?? $"Producto ID {detalle.IdProducto}")</td>
                        <td>S/ @detalle.Precio.ToString("N2")</td>
                        <td>@detalle.Cantidad</td>
                        <td>S/ @detalle.Subtotal.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="text-end">
            <h4>Total: S/ @Model.Total.ToString("N2")</h4>
        </div>
    </div>
</div>