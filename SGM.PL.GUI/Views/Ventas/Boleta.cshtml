@model SGM.Domain.Entities.Venta
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Boleta #@Model.Id</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
            body {
                background: #f5f5f5;
                padding: 20px;
            }

            .boleta {
                max-width: 420px;
                margin: 0 auto;
                background: #fff;
                padding: 24px;
                border-radius: 8px;
                box-shadow: 0 4px 16px rgba(0,0,0,0.08);
                font-size: 14px;
            }

                .boleta h4 {
                    text-align: center;
                    margin-bottom: 4px;
                }

                .boleta .sub {
                    text-align: center;
                    color: #666;
                    margin-bottom: 16px;
                }

                .boleta table {
                    width: 100%;
                }

                .boleta th, .boleta td {
                    padding: 4px 0;
                }

            .total {
                border-top: 1px dashed #999;
                margin-top: 10px;
                padding-top: 10px;
                font-weight: bold;
                font-size: 16px;
            }
    </style>
</head>
<body>
    <!-- SOLO ESTO se convierte en imagen -->
    <div id="boleta" class="boleta">
        <h4>SGM Minimarket</h4>
        <div class="sub">Boleta de Venta N° @Model.Id</div>

        <div class="mb-2">
            <div><strong>Fecha:</strong> @Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</div>
            <div>
                <strong>Cliente:</strong>
                @(Model.Cliente != null ? $"{Model.Cliente.Nombres} {Model.Cliente.Apellidos}" : $"ID {Model.IdCliente}")
            </div>
            <div>
                <strong>Cajero:</strong>
                @(Model.Usuario != null ? $"{Model.Usuario.Nombres} {Model.Usuario.Apellidos}" : $"ID {Model.IdUsuario}")
            </div>
        </div>

        <hr />

        <table>
            <thead>
                <tr>
                    <th>Producto</th>
                    <th class="text-end">Cant</th>
                    <th class="text-end">Importe</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Detalles != null && Model.Detalles.Any())
                {
                    foreach (var d in Model.Detalles)
                    {
                        <tr>
                            <td>@(d.Producto?.Nombre ?? $"Producto {d.IdProducto}")</td>
                            <td class="text-end">@d.Cantidad</td>
                            <td class="text-end">S/ @d.Subtotal.ToString("N2")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <div class="total d-flex justify-content-between">
            <span>TOTAL</span>
            <span>S/ @Model.Total.ToString("N2")</span>
        </div>

        <div class="text-center mt-3 text-muted">
            ¡Gracias por su compra!
        </div>
    </div>

    <!-- Estos botones NO entran en la imagen -->
    <div class="text-center mt-3">
        <button type="button" class="btn btn-success" onclick="descargarBoleta()">
            Descargar boleta
        </button>
        <button type="button" class="btn btn-secondary" onclick="window.close()">
            Cerrar
        </button>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
    <script>
            function descargarBoleta() {
                const elemento = document.getElementById('boleta');

                html2canvas(elemento, {
                    backgroundColor: '#ffffff',
                    scale: 2
                }).then(canvas => {
                    const link = document.createElement('a');
                    link.download = '@($"Boleta_{Model.Id}.png")';
                    link.href = canvas.toDataURL('image/png');
                    link.click();
                });
            }
    </script>
</body>
</html>