@model List<SGM.Domain.Entities.Venta>
@{
    ViewData["Title"] = "Ventas";
    var rol = Context.Session.GetString("Rol");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Ventas</h2>
    <a href="/Ventas/Create" class="btn btn-success">
        <i class="bi bi-cart-plus"></i> Nueva Venta
    </a>
</div>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Fecha</th>
            <th>Cliente</th>
            <th>Usuario</th>
            <th>Total</th>
            <th>Estado</th>
            <th style="width:150px">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@item.IdCliente</td>
                <td>@item.IdUsuario</td>
                <td>S/ @item.Total.ToString("N2")</td>
                <td>
                    @if (item.Estado == "Completada")
                    {
                        <span class="badge bg-success">@item.Estado</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">@item.Estado</span>
                    }
                </td>
                <td>
                    <a href="/Ventas/Details/@item.Id" class="btn btn-sm btn-outline-primary">Ver</a>
                    @if (rol == "Administrador" && item.Estado == "Completada")
                    {
                        <a href="/Ventas/Anular/@item.Id" class="btn btn-sm btn-outline-danger"
                           onclick="return confirm('¿Anular esta venta?')">Anular</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>